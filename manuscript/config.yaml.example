# PIZ GLORIA manuscript config reference
# Copy to config.yaml as the starting point for a new film; edit freely.

paper:
  title: "On Her Majesty's Secret Service: PIZ GLORIA — Special-Agent Mission Software"
  subtitle: "Aerosol bioweapon dispersion, bobsleigh-grade alpine routes, and the Bray cover identity"
  version: "0.1.0"
  date: "2026-08-04"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

publication:
  journal: "BOND Suite Technical Series"
  year: "2026"

keywords:
  - "aerosol bioweapon dispersion"
  - "Gaussian plume model"
  - "alpine route planning"
  - "slope safety"
  - "cover-identity risk scoring"
  - "reproducible research"

metadata:
  license: "MIT"
  language: "en"

render:
  formats:
    pdf: true
    html: false
    slides: false
    docx: false
    epub: false

testing:
  max_test_failures: 0
  max_infra_test_failures: 0
  max_project_test_failures: 0

mission:
  film: "on_her_majestys_secret_service"
  codename: "PIZ GLORIA"
  reference_film: true
  domain:
    dispersion: "gaussian plume + valley channeling"
    alpine: "dijkstra safe-route planner"
    cover: "weighted Bray-persona risk model"
  scenario:
    release_rate_kg_s: 0.05
    wind_speed_m_s: 4.0
    release_height_m: 25.0
    stability: "C"
    valley_depth_m: 400.0
  isopleth_threshold_kg_m3: 1.0e-7
