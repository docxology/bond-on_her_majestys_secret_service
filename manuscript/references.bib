% Verified 2026-08-05. A previous revision gave this as "Factors influencing
% performance in bobsled: Part I: kinematics", Journal of Biomechanics
% 22(8-9):965-970. Every one of those fields was wrong: the paper is in the
% International Journal of Sport Biomechanics, volume 5, and its Part I
% subtitle concerns the crew and the environment, not kinematics.
% Scope, stated honestly: the study regresses bobsled finish time on start
% order, ice temperature and push time. It supports treating bobsleigh
% performance as a measurable multi-factor problem; it is NOT a source for the
% point-mass descent equations in descent_dynamics.py, which are ordinary
% rigid-body mechanics and need no citation.
@article{morlock1989bobsled,
  author  = {Morlock, M. M. and Zatsiorsky, V. M.},
  title   = {Factors influencing performance in bobsledding: {I}: Influences of the bobsled crew and the environment},
  journal = {International Journal of Sport Biomechanics},
  volume  = {5},
  number  = {2},
  pages   = {208--221},
  year    = {1989}
}

